cd ~/projects/demand-forecasting-replenishment-engine

cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyc
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# Secrets and environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Raw data
data/raw/

# Temporary and log files
*.tmp
*.log
EOF